FROM node:22-bookworm

# Установка OpenJDK, zip и утилит
RUN apt-get update && apt-get install -y openjdk-17-jdk wget unzip zip && rm -rf /var/lib/apt/lists/*

# Настройка Android SDK
ENV ANDROID_HOME="/opt/android-sdk"
ENV PATH="${PATH}:${ANDROID_HOME}/cmdline-tools/latest/bin:${ANDROID_HOME}/platform-tools"

RUN mkdir -p ${ANDROID_HOME}/cmdline-tools && \
    wget -q https://dl.google.com/android/repository/commandlinetools-linux-9477386_latest.zip -O android-tools.zip && \
    unzip -q android-tools.zip -d ${ANDROID_HOME}/cmdline-tools && \
    rm android-tools.zip && \
    mv ${ANDROID_HOME}/cmdline-tools/cmdline-tools ${ANDROID_HOME}/cmdline-tools/latest

# Принятие лицензий и установка компонентов SDK
RUN mkdir -p ${ANDROID_HOME}/licenses && \
    echo "24333f8a63b6825ea9c5514f83c2829b004d1fee" > ${ANDROID_HOME}/licenses/android-sdk-license && \
    echo "84831b9409646a918e30573bab4c9c91346d8abd" >> ${ANDROID_HOME}/licenses/android-sdk-license && \
    echo "33b6a2b64607f11b759f320ef9dff4ae5c47d97a" >> ${ANDROID_HOME}/licenses/android-sdk-license && \
    echo "e5443be1267ea0445dcb9ac9c020f1df296e680a" >> ${ANDROID_HOME}/licenses/android-sdk-license && \
    echo "d975f751698a77b662f1254ddbeed3901e976f5a" >> ${ANDROID_HOME}/licenses/android-sdk-license && \
    echo "8933bad161af4178b1185d1a37fbf41ea5269c55" > ${ANDROID_HOME}/licenses/android-sdk-preview-license && \
    echo "d56f5187479451eabf01fb78af6dfcb131a6481e" > ${ANDROID_HOME}/licenses/android-googletv-license && \
    echo "33b6a2b64607f11b759f320ef9dff4ae5c47d97a" > ${ANDROID_HOME}/licenses/google-gdk-license && \
    echo "e9acab5b5fbb560a72cfaecce8946896ff6aab9d" > ${ANDROID_HOME}/licenses/mips-android-sysimage-license && \
    sdkmanager "platform-tools" "platforms;android-33" "build-tools;33.0.2" "build-tools;37.0.0"

# Замена x86_64 утилит сборки на ARM64 (для работы на Raspberry Pi / ARM Macs), если требуется
RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/* && \
    if [ "$(uname -m)" = "aarch64" ] || [ "$(uname -m)" = "arm64" ]; then \
        curl -s https://raw.githubusercontent.com/Commit451/android-arm-build-tools/main/install.sh | bash; \
    else \
        echo "Running on x86_64, skipping ARM build tools replacement."; \
    fi

# Заставляем Gradle использовать нативный aapt2 вместо скачивания x86_64 версии из Maven
RUN mkdir -p /root/.gradle && echo "android.aapt2FromMavenOverride=/opt/android-sdk/build-tools/37.0.0/aapt2" >> /root/.gradle/gradle.properties

# Установка Gradle (Глобально)
ENV GRADLE_VERSION="8.5"
RUN wget -q https://services.gradle.org/distributions/gradle-${GRADLE_VERSION}-bin.zip -O gradle.zip && \
    unzip -q gradle.zip -d /opt && \
    rm gradle.zip && \
    mv /opt/gradle-${GRADLE_VERSION} /opt/gradle
ENV PATH="${PATH}:/opt/gradle/bin"

# Настройка рабочей директории
WORKDIR /app
